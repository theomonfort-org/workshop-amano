---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('playbook');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// 全エントリの目次データ（プレゼン用サイドバー）
const allEntries = (await getCollection('playbook'))
  .sort((a, b) => {
    if (a.data.order !== b.data.order) return a.data.order - b.data.order;
    return a.data.title.localeCompare(b.data.title, 'ja');
  })
  .map((e) => ({
    id: e.id,
    title: e.data.title,
    icon: e.data.icon,
    color: e.data.color,
  }));

const tocJson = JSON.stringify({
  current: entry.id,
  entries: allEntries,
});
---
<BaseLayout title={`${entry.data.title} — Playbook`} description={entry.data.summary}>
  <main class="mx-auto max-w-4xl px-6 py-10 sm:px-10">
    <nav class="mb-6 font-mono text-xs text-neon-cyan">
      <a href="/" class="hover:text-neon-magenta">&larr; インデックスへ戻る</a>
    </nav>

    <header class="mb-8 border-b-2 border-neon-magenta pb-6">
      <div class="flex items-start gap-4">
        <div class="text-5xl leading-none" aria-hidden="true">{entry.data.icon}</div>
        <div class="min-w-0">
          {entry.data.category && (
            <div class="font-mono text-[11px] uppercase tracking-widest text-phosphor/60">
              {entry.data.category}
            </div>
          )}
          <h1
            class="mt-1 font-pixel-jp text-3xl text-neon-magenta sm:text-4xl"
            style="text-shadow: 0 0 12px rgba(255,46,136,0.5);"
          >
            {entry.data.title}
          </h1>
          {entry.data.titleEn && (
            <div class="font-pixel mt-2 text-[10px] uppercase tracking-[0.3em] text-phosphor/60">
              {entry.data.titleEn}
            </div>
          )}
          <p class="mt-3 text-sm text-phosphor/85 sm:text-base">{entry.data.summary}</p>
        </div>
      </div>

      <div class="mt-5 flex flex-wrap items-center gap-3 font-mono text-xs text-phosphor/70">
        <span class="border border-neon-cyan px-2 py-1 text-neon-cyan">
          <kbd class="font-bold">P</kbd> でプレゼンモード切替
        </span>
        <span class="border border-crt-amber px-2 py-1 text-crt-amber">
          <kbd class="font-bold">←</kbd> / <kbd class="font-bold">→</kbd> スライド移動
        </span>
        <span class="border border-phosphor/40 px-2 py-1">
          <kbd class="font-bold">Esc</kbd> 通常表示
        </span>
      </div>
    </header>

    <article id="playbook-article" class="playbook-article">
      <Content />
    </article>

    {entry.data.links && entry.data.links.length > 0 && (
      <section class="mt-10 border-t border-neon-cyan/40 pt-6">
        <h2 class="font-pixel-jp text-xl text-neon-cyan">関連リンク</h2>
        <ul class="mt-3 space-y-1">
          {entry.data.links.map((link) => (
            <li>
              <a
                href={link.url}
                class="text-neon-cyan underline hover:text-neon-magenta"
                target="_blank"
                rel="noopener noreferrer"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </main>

  <!-- プレゼンモードオーバーレイ（クライアントから差し込む） -->
  <div id="presentation-mode" aria-hidden="true"></div>

  <!-- 全エントリ目次（プレゼンサイドバー用） -->
  <script type="application/json" id="playbook-toc" set:html={tocJson}></script>

  <script src="../../scripts/presentation.ts"></script>
</BaseLayout>
