---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'playbook'>;
}

const { entry } = Astro.props;
const { title, titleEn, summary, icon, color, category } = entry.data;

const colorMap: Record<string, { border: string; text: string; hoverShadow: string }> = {
  cyan: {
    border: 'border-neon-cyan',
    text: 'text-neon-cyan',
    hoverShadow: 'hover:shadow-[0_0_8px_#00f0ff,0_0_24px_rgba(0,240,255,0.45)]',
  },
  magenta: {
    border: 'border-neon-magenta',
    text: 'text-neon-magenta',
    hoverShadow: 'hover:shadow-[0_0_8px_#ff2e88,0_0_24px_rgba(255,46,136,0.45)]',
  },
  amber: {
    border: 'border-crt-amber',
    text: 'text-crt-amber',
    hoverShadow: 'hover:shadow-[0_0_8px_#ffb000,0_0_24px_rgba(255,176,0,0.45)]',
  },
  green: {
    border: 'border-gb-green',
    text: 'text-gb-green',
    hoverShadow: 'hover:shadow-[0_0_8px_#9bbc0f,0_0_24px_rgba(155,188,15,0.45)]',
  },
};

const c = colorMap[color] ?? colorMap.cyan;
---
<a
  href={`/playbook/${entry.id}/`}
  class:list={[
    'group relative block h-full border-2 bg-midnight/80 p-5 transition hover:-translate-y-1',
    c.border,
    c.hoverShadow,
  ]}
>
  <div class="flex items-start gap-3">
    <div class:list={['text-4xl leading-none', c.text]} aria-hidden="true">{icon}</div>
    <div class="min-w-0 flex-1">
      {category && (
        <div class="font-mono text-[10px] uppercase tracking-widest text-phosphor/60">
          {category}
        </div>
      )}
      <h2 class:list={['font-pixel-jp text-lg leading-tight', c.text]}>
        {title}
      </h2>
      {titleEn && (
        <div class="font-pixel mt-1 text-[9px] uppercase tracking-widest text-phosphor/50">
          {titleEn}
        </div>
      )}
    </div>
  </div>
  <p class="mt-3 text-sm leading-relaxed text-phosphor/85">
    {summary}
  </p>
  <div class:list={['mt-4 text-right font-mono text-xs', c.text]}>
    &gt; OPEN_
  </div>
</a>
